# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit the real key.

# REQUIRED — Todoist API key (Settings -> Integrations -> Developer).
# Note the name: the server expects TODOIST_API_KEY, not TODOIST_API_TOKEN.
TODOIST_API_KEY=

# OPTIONAL — defaults shown; uncomment to override.

# Bind address inside the container. 0.0.0.0 is required for the server to be
# reachable from outside it.
# HOST=0.0.0.0

# Listen port.
# PORT=3000

# Host header allowlist. Hostname only (the port is ignored); must include the
# hostname clients use, or /mcp returns 403.
# ALLOWED_HOSTS=todoist-mcp,todoist-mcp:3000,localhost,localhost:3000,127.0.0.1:3000

# Host-side bind address and published port. BIND_ADDR=0.0.0.0 exposes the
# server beyond the local machine.
# BIND_ADDR=127.0.0.1
# HOST_PORT=3000

# Upstream version, used only to tag a locally built image.
# TODOIST_MCP_VERSION=13.2.5
